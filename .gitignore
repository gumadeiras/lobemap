__pycache__/
*.py[cod]
.venv/
*.egg-info/
build/
dist/
.DS_Store

# local caches of bridged/derived geometry and downloaded transforms
cache/
data/cache/

# Built assets. Everything under registry/data is derived, and now all of
# it is fetched rather than tracked: 14 artifacts, 2.51 GB, published as
# release assets. `registry/manifest.toml` is the source of truth for what
# belongs here and what each file's sha256 must be; `lobemap fetch` puts it
# on disk and verifies it.
#
# The eleven small ones used to be tracked so a clone could open a scene
# without a network round trip. Splitting the rule by size meant the
# repository and the release disagreed about where the data lived, and the
# 76 MB it saved was not worth two answers to one question.
registry/data/*
!registry/data/README.md
